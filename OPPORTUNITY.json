    {
      "parameters": {
        "promptType": "define",
        "text": "=You evaluate student opportunities for a Computer Science / AI-ML university student.\n\nYou are given a JSON array of opportunities. Evaluate EVERY item in the array.\n\nFor each opportunity return an object with exactly these fields:\n- title: copy the title from the input.\n- url: copy the url from the input.\n- deadline: copy the deadline from the input (use the input value, do not invent one).\n- relevant: true only if it is genuinely useful for CS, AI, ML, coding, technology, research, innovation, entrepreneurship, or a strong student career opportunity.\n- score: integer from 0 to 10.\n- priority: HIGH for 8-10, MEDIUM for 5-7, LOW for 0-4.\n- category: short category such as AI/ML, Hackathon, Coding, Research, Entrepreneurship, Student Program, Competition, or Other.\n- reason: one short sentence.\n\nBe conservative. Do not assume eligibility, deadlines, prizes, or international access unless supported by the input. Only use the opportunities provided below — never invent opportunities. Return exactly one result object for every input opportunity, in the same order.\n\nOpportunities (JSON array):\n{{ JSON.stringify($input.all().map(i => i.json)) }}\n\nReturn ONLY the structured output as {\"results\": [ ... ]}.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a conservative opportunity evaluation assistant for university students. Score and classify each opportunity from the provided JSON array and return only the requested fields as a JSON object with a \"results\" array."
        }
      },
      "id": "3ae07ebc-ea2f-4ecd-904d-52a16888f9bd",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1344,
        -288
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"results\": [\n    {\n      \"title\": \"Build with Gemini XPRIZE\",\n      \"url\": \"https://xprize.devpost.com/\",\n      \"deadline\": \"May 19 - Aug 17, 2026\",\n      \"relevant\": true,\n      \"priority\": \"HIGH\",\n      \"score\": 9,\n      \"reason\": \"Strong AI and technology opportunity suitable for a university CSE/AIML student.\",\n      \"category\": \"AI/ML\"\n    }\n  ]\n}"
      },
      "id": "8cf17a3e-f82f-43e3-85ac-1a36203c4adb",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1536,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const keywords = [\n  'ai',\n  'artificial intelligence',\n  'machine learning',\n  'ml',\n  'deep learning',\n  'data science',\n  'computer science',\n  'software',\n  'coding',\n  'developer',\n  'programming',\n  'technology',\n  'tech',\n  'hackathon',\n  'competition',\n  'challenge',\n  'fellowship',\n  'scholarship',\n  'student',\n  'campus',\n  'research',\n  'innovation',\n  'startup',\n  'entrepreneur',\n  'gemini',\n  'cloud',\n  'cybersecurity',\n  'robotics'\n];\n\nreturn $input.all().filter(item => {\n  const text = [\n    item.json.title,\n    item.json.organization,\n    item.json.location,\n    item.json.url\n  ]\n    .filter(Boolean)\n    .join(' ')\n    .toLowerCase();\n\n  return keywords.some(keyword => text.includes(keyword));\n});"
      },
      "id": "799417ee-7898-4df2-989b-4ba79dd353ea",
      "name": "Ai Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst unique = [];\n\nfor (const item of $input.all()) {\n  const opportunity = item.json;\n\n  const key = (opportunity.title || '')\n    .trim()\n    .toLowerCase();\n\n  if (!key) {\n    unique.push(item);\n    continue;\n  }\n\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(item);\n  }\n}\n\nreturn unique;"
      },
      "id": "c45c3775-d288-4f1c-8026-96ec5bb04541",
      "name": "duplicate removal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        -192
      ]
    },
    {
      "parameters": {
        "jsCode": "// Items arriving here are already normalized by the upstream source\n// sub-workflows / Merge / Ai Filter / duplicate removal steps.\n// Each item is a flat object: { title, organization, url, deadline, location, status, source }.\n// Map them through, preserving the fields the rest of the flow expects.\n// deadline is coerced to a string so the downstream structured output parser\n// (which requires a string) never receives null.\n\nreturn $input.all().map(item => {\n  const o = item.json;\n  const deadline =\n    o.deadline === null || o.deadline === undefined || o.deadline === ''\n      ? 'Not specified'\n      : String(o.deadline);\n  return {\n    json: {\n      title: o.title,\n      url: o.url,\n      organization: o.organization,\n      location: o.location,\n      status: o.status,\n      deadline: deadline,\n      source: o.source,\n    },\n  };\n});"
      },
      "id": "11998120-2af3-4c52-a7fd-98dabd8963a3",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const opportunityKeywords = [\n  'hackathon',\n  'competition',\n  'challenge',\n  'xprize',\n  'cup',\n  'fellowship',\n  'scholarship',\n  'ambassador',\n  'accelerator',\n  'internship',\n  'program',\n  'contest',\n  'prize',\n  'summit'\n];\n\nconst excludeKeywords = [\n  'for beginners',\n  'learning center',\n  'student developer pack',\n  'community/events',\n  'learn more',\n  'tutorial',\n  'course'\n];\n\nreturn $input.all().filter(item => {\n  const title = (item.json.title || '').toLowerCase();\n\n  const looksLikeOpportunity =\n    opportunityKeywords.some(k => title.includes(k));\n\n  const looksLikeResource =\n    excludeKeywords.some(k => title.includes(k));\n\n  return looksLikeOpportunity && !looksLikeResource;\n});"
      },
